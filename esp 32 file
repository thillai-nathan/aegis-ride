// Returns the most accurate current rider coordinates available:
double getEffectiveLat() {
  if (hasGPSFix && (realLat != 0.0 || realLng != 0.0)) return realLat;
  if (hasPhoneFix && (phoneLat != 0.0 || phoneLng != 0.0)) return phoneLat;
  return netLat;
}
double getEffectiveLng() {
  if (hasGPSFix && (realLat != 0.0 || realLng != 0.0)) return realLng;
  if (hasPhoneFix && (phoneLat != 0.0 || phoneLng != 0.0)) return phoneLng;
  return netLng;
}
