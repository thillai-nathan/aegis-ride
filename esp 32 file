// ---- Info pages: LAST EVENT -> RECENT LOG -> COUNTS -> SYSTEM STATUS ----
void nextInfoPage() {
  infoPage++;
  if (infoPage > INFO_PAGES) { infoPage = 0; oledHoldUntil = 0; lastOledRefresh = 0; return; }
  infoPageUntil = millis() + INFO_PAGE_MS;
  oledHoldUntil = 0;
  drawInfoPage(infoPage);
}

void drawInfoPage(int p) {
  if (!oledAvailable) return;
  memset(oled_buffer, 0, sizeof(oled_buffer));
  char b[32];
  const EvtRec* e = newestEvt(0);
  bool inSosSeq = (sosPressCount > 0 && (millis() - lastSosPressMs <= SOS_SEQUENCE_WINDOW_MS));

  if (p == 1) {
    if (inSosSeq) oled_draw_string(2, 0, "SOS PRESS: 1/3 (LAST)");
    else          oled_draw_string(2, 0, "== SAVED LAST EVENT ==");
    if (!e) {
      oled_draw_string(2, 2, "LAST: NONE");
      oled_draw_string(2, 3, "NO ROAD EVENTS YET");
    } else {
      oled_draw_string(2, 2, e->tag);
      oled_draw_string(2, 3, e->sub);
      oledPrintf(2, 4, "SHOCK:%.2fG TILT:%dD", e->g, (int)(e->tilt + 0.5f));
      unsigned long s = (millis() - e->t) / 1000;
      if (s < 120) oledPrintf(2, 5, "TIME: %lu SEC AGO", s);
      else         oledPrintf(2, 5, "TIME: %lu MIN AGO", s / 60);
    }
    oledPrintf(2, 7, "2ND CLICK: EVENT LIST");
  } else if (p == 2) {
    if (inSosSeq) oled_draw_string(2, 0, "SOS PRESS: 2/3 (LIST)");
    else          oled_draw_string(2, 0, "== EVENT LIST & LOG ==");
    if (!e) {
      oled_draw_string(2, 2, "NO EVENTS RECORDED");
    } else {
      for (unsigned int i = 0; i < 3; i++) {
        const EvtRec* r = newestEvt(i);
        if (!r) break;
        snprintf(b, sizeof(b), "%u.%s %.1fG", i + 1, r->tag, r->g);
        b[21] = 0;
        oled_draw_string(2, 1 + i, b);
      }
    }
    oledPrintf(2, 4, "POT:%u/%u/%u BMP:%u", cntMinor, cntMedium, cntSevere, cntSpeedBreaker);
    if (WiFi.status() == WL_CONNECTED) {
      oledPrintf(2, 5, "IP:%s", WiFi.localIP().toString().c_str());
    } else {
      oled_draw_string(2, 5, "AP: 192.168.4.1");
    }
    oled_draw_string(2, 7, "3RD CLICK: SEND SOS!");
  } else if (p == 3) {
    oledPrintf(2, 0, "== COUNTS %d/%d ==", p, INFO_PAGES);
    oledPrintf(2, 1, "MINOR POTHOLE  : %u", cntMinor);
    oledPrintf(2, 2, "MEDIUM POTHOLE : %u", cntMedium);
    oledPrintf(2, 3, "SEVERE POTHOLE : %u", cntSevere);
    oledPrintf(2, 4, "SPEED BREAKER  : %u", cntSpeedBreaker);
    oledPrintf(2, 5, "CRASH: %u  SOS: %u", cntCrash, cntSOS);
    oledPrintf(2, 6, "MAX SHOCK: %.2fG", maxShockG);
  } else {
    oledPrintf(2, 0, "== STATUS %d/%d ==", p, INFO_PAGES);
    gpsStatusLine(b, sizeof(b));
    oled_draw_string(2, 1, b);
    if (hasGPSFix)          oledPrintf(2, 2, "%.4f,%.4f", realLat, realLng);
    else if (hasEverHadFix) oled_draw_string(2, 2, "LOC: LAST KNOWN");
    else                    oled_draw_string(2, 2, "LOC: NOT LOCKED");
    oledPrintf(2, 3, "SPD: %d KM/H", (int)curSpeedKmh());
    oledPrintf(2, 4, "WIFI: %s", WiFi.status() == WL_CONNECTED ? "OK" : "OFFLINE");
    if (isBatteryConnected) oledPrintf(2, 5, "BAT: %d%% %.2fV", batteryPercentage, batteryVoltage);
    else                    oled_draw_string(2, 5, "BAT: USB POWERED");
    oledPrintf(2, 6, "MPU:%s TILT:%dD", mpuConnected ? "OK" : "LOST", (int)(tiltDev + 0.5f));
    oledPrintf(2, 7, "GPS BYTES: %lu", totalGpsBytes);
  }
  oled_send_buffer();
}

