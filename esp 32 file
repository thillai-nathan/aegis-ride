void startCrash(const char* reason, float g) {
  currentState = STATE_CRASH_COUNTDOWN;
  countdownSeconds = countdownMaxSeconds;
  lastCountdownTick = millis();
  windowOpen = false; pendingCrash = false;
  crashPeakG = g; crashTilt = pitchDeg;
  sbLatched = true; sbStart = 0;
  strncpy(crashReason, reason, sizeof(crashReason) - 1); crashReason[sizeof(crashReason) - 1] = 0;
  alarmActive = true;                // beeps for the whole 15 s countdown (see updateBuzzer)
  if (buzzerAudioEnabled) digitalWrite(PIN_BUZZER, HIGH);
  infoPage = 0; oledHoldUntil = 0;
  cntCrash++;
  if (g > maxShockG) maxShockG = g;

  recordLastEvent("CRASH", reason, g, tiltDev);
  Serial.println(String("[ALGORITHM] CRASH DETECTED! ") + reason + " " + String(g, 2) + "G (15s Countdown started)");
  showOledCrashCountdown(countdownSeconds);

  String evt = "{";
  evt += "\"type\":\"crash_detected\",";
  evt += "\"g_force\":" + String(g, 2) + ",";
  evt += "\"pitch\":" + String(pitchDeg, 1) + ",";
  evt += "\"roll\":" + String(rollDeg, 1) + ",";
  evt += "\"reason\":\"" + String(reason) + "\",";
  evt += "\"countdown\":" + String(countdownSeconds);
  evt += "}";
  broadcastJSON(evt);
}

void startSosCountdown(const char* reason) {
  currentState = STATE_CRASH_COUNTDOWN;
  countdownSeconds = countdownMaxSeconds; // 15 seconds
  lastCountdownTick = millis();
  windowOpen = false; pendingCrash = false;
  crashPeakG = fmaxf(shockShown, currentG); crashTilt = tiltDev;
  sbLatched = true; sbStart = 0;
  strncpy(crashReason, reason, sizeof(crashReason) - 1); crashReason[sizeof(crashReason) - 1] = 0;
  alarmActive = true;                // beeps during 15s countdown
  if (buzzerAudioEnabled) digitalWrite(PIN_BUZZER, HIGH);
  infoPage = 0; oledHoldUntil = 0;
  recordLastEvent("SOS ALERT", reason, crashPeakG, tiltDev);
  Serial.println("\n🚨 [EMERGENCY] 15-SECOND SOS COUNTDOWN STARTED! Press button to turn off / cancel.");
  showOledCrashCountdown(countdownSeconds);

  String evt = "{";
  evt += "\"type\":\"sos_countdown\",";
  evt += "\"reason\":\"" + String(reason) + "\",";
  evt += "\"countdown\":" + String(countdownSeconds);
  evt += "}";
  broadcastJSON(evt);
}

void dispatchSOS(const char* mode, float g, bool isCrash) {
  currentState = STATE_SOS_DISPATCHED;
  alarmActive = false;
  windowOpen = false; pendingCrash = false; infoPage = 0; oledHoldUntil = 0;
  playBuzzerPattern(3, 140, 100, 2500); // 3 crisp SOS alert pulses
  cntSOS++;
  // Preserve the saved Last Event (pothole/bump/tilt/rollover/crash) instead of overwriting it with "SOS ALERT"
  if (isCrash && evtCount == 0) {
    recordLastEvent("CRASH DETECTED", "AUTO COUNTDOWN", g, tiltDev);
  }
  Serial.println(String("[SOS] Dispatching, mode=") + mode);

  sosPending = true; sosAttempts = 0; sosDone[0] = sosDone[1] = false;
  sosG = g; sosIsCrash = isCrash;
  sosDispatchedAtMs = millis();
  sosStatusShownUntilMs = millis() + SOS_TEMP_BANNER_MS;
  snprintf(sosStatus, sizeof(sosStatus), "SENDING SOS...");
  snprintf(sosDetail, sizeof(sosDetail), "CONNECTING TG API");
  showOledSosDispatched();

  String sosMsg = "{";
  sosMsg += "\"type\":\"sos\",";
  sosMsg += "\"mode\":\"" + String(mode) + "\",";
  sosMsg += "\"lat\":" + String(realLat, 6) + ",";
  sosMsg += "\"lng\":" + String(realLng, 6) + ",";
  sosMsg += "\"gps_fix\":" + String(hasGPSFix ? "true" : "false");
  sosMsg += "}";
  broadcastJSON(sosMsg);

#if ENABLE_BLUETOOTH
  if (SerialBT.hasClient()) {
    SerialBT.println("\n🚨 [AEGIS EMERGENCY SOS DISPATCHED] 🚨");
    SerialBT.println(buildSosText());
  }
#endif

  attemptSOS();
}

void cancelAlarm(const char* reason) {
  currentState = STATE_NORMAL;
  countdownSeconds = countdownMaxSeconds;
  alarmActive = false;
  setBuzzerTone(0); digitalWrite(PIN_BUZZER, LOW);     // buzzer OFF immediately
  buzzerOffAt = 0;
  sosPending = false;
  windowOpen = false; pendingCrash = false;
  crashCooldownUntil = millis() + 3000;
  sbLatched = true; sbStart = 0;       // still lying tilted? no speed-breaker beep until it is flat again
  Serial.println(String("[CANCEL] Alarm turned off / cancelled: ") + reason);
  showOledCancel();
  broadcastJSON("{\"type\":\"cancel\",\"reason\":\"" + String(reason) + "\"}");

#if ENABLE_BLUETOOTH
  if (SerialBT.hasClient()) {
    SerialBT.println("🛡️ [ALARM TURNED OFF]: Rider is safe (" + String(reason) + ")");
  }
#endif
}

void dismissSOS() {                   // dismiss the screen/re-arm; do not cancel a pending Telegram retry
  currentState = STATE_NORMAL;
  alarmActive = false;
  setBuzzerTone(0); digitalWrite(PIN_BUZZER, LOW);
  buzzerOffAt = 0;
  // Leave sosPending unchanged so failed delivery can still retry in the background.
  windowOpen = false; pendingCrash = false;
  crashCooldownUntil = millis() + 3000;
  sbLatched = true; sbStart = 0;
  Serial.println("[SOS] Screen dismissed and system re-armed; any pending Telegram retry continues.");
  showOledDismiss();
  broadcastJSON("{\"type\":\"cancel\",\"reason\":\"sos_dismissed\"}");

#if ENABLE_BLUETOOTH
  if (SerialBT.hasClient()) {
    SerialBT.println("🛡️ [SOS DISMISSED]: System re-armed.");
  }
#endif
}

void updateCrashCountdown() {
  if (currentState != STATE_CRASH_COUNTDOWN) return;
  if (millis() - lastCountdownTick >= 1000) {
    lastCountdownTick += 1000;
    countdownSeconds--;
    showOledCrashCountdown(countdownSeconds > 0 ? countdownSeconds : 0);

    String tick = "{";
    tick += "\"type\":\"countdown\",";
    tick += "\"seconds_left\":" + String(countdownSeconds) + ",";
    tick += "\"seconds_remaining\":" + String(countdownSeconds);
    tick += "}";
    broadcastJSON(tick);

    if (countdownSeconds <= 0) {
      Serial.println("[SAFEGUARD] Countdown reached 0 -> AUTO SOS!");
      bool isRealCrash = (strstr(crashReason, "3-CLICK") == NULL && strstr(crashReason, "MANUAL") == NULL);
      dispatchSOS("automated_countdown_expiry", crashPeakG, isRealCrash);
    }
  }
}

// ============================================================================
// MOTION CLASSIFICATION
// ============================================================================
void classifyPothole(float g) {
  if (g < minorPotholeThreshold) {
    Serial.printf("[MOTION] Ignored (too weak): shock %.2fG (minor pothole starts at %.2fG)\n", g, minorPotholeThreshold);
    return;
  }
  int level = (g >= severePotholeThreshold) ? 3 : (g >= mediumPotholeThreshold) ? 2 : 1;
  emitPothole(level, g, false);
}

void checkMotionEvents() {
  unsigned long now = millis();
  float peak = peakDyn;
  peakDyn = 0;
  bool  impact  = crashImpactSeen;
  float impactG = crashImpactPeak;
  crashImpactSeen = false; crashImpactPeak = 0;

  if (!calibrated || currentState != STATE_NORMAL) { windowOpen = false; pendingCrash = false; return; }

  // is the board being tilted / lifted right now?
  static unsigned long lastTiltSample = 0;
  static float prevTilt = 0;
  if (now - lastTiltSample >= 50) {
    float dtS = (now - lastTiltSample) / 1000.0f;
    tiltRate = fabsf(tiltDev - prevTilt) / dtS;                // deg per second
    if (fabsf(tiltDev - prevTilt) > 2.0f) tiltBusyUntil = now + 500;
    prevTilt = tiltDev; lastTiltSample = now;
  }
  bool tiltBusy = (now < tiltBusyUntil) || (tiltDev >= TILT_BUSY_DEG);

  // Wait 3 seconds after boot/calibration before arming automatic motion SOS (prevents false SOS on reset!)
  if (now - calibratedAtMs < 3000UL) {
    crashImpactSeen = false;
    crashImpactPeak = 0;
    return;
  }

  // ---- STANDALONE RULE 1: SEVERE CRASH IMPACT FORCE >= 10.0 G ALONE (Immediate SOS, no tilt needed!) ----
  float maxForceSeen = fmaxf(impactG, fmaxf(peak, fmaxf(shockShown, currentG)));
  if (now >= crashCooldownUntil && (impact || maxForceSeen >= crashImpactThreshold)) {
    impactG = maxForceSeen;
    windowOpen = false;
    pendingCrash = false;
    crashCooldownUntil = now + 5000UL;
    cntCrash++;
    if (impactG > maxShockG) maxShockG = impactG;
    snprintf(crashReason, sizeof(crashReason), "FORCE >=10G CRASH");
    snprintf(sosCustomAlertLine, sizeof(sosCustomAlertLine),
             "SEVERE CRASH IMPACT: Force %.2f G (>= 10 G Standalone Crash Detected)!",
             impactG);
    recordLastEvent("CRASH >=10G", "SEVERE FORCE ALONE", impactG, tiltDev);
    Serial.printf("[EMERGENCY] STANDALONE CRASH FORCE >= 10G DETECTED (%.2f G) -> SENDING SOS IMMEDIATELY!\n", impactG);
    dispatchSOS("AUTO_CRASH_FORCE_10G", impactG, true);
    return;
  }

  bool moving = DESK_TEST_MODE || !hasGPSFix || curSpeedKmh() >= ROAD_MIN_SPEED_KMH;

  // Use calibrated tiltDev (which is 0.0 deg when resting after calibration!) so a tilted breadboard never false-triggers on reset!
  float dPitch = ay_g - refY;
  float dRoll  = ax_g - refX;
  bool isNegativeTilt = (fabsf(dPitch) >= fabsf(dRoll)) ? (dPitch < 0.0f) : (dRoll < 0.0f);
  float maxAbsTilt = tiltDev;
  float signedTilt = isNegativeTilt ? -tiltDev : +tiltDev;
  const char* tiltDir = isNegativeTilt ? "-NEGATIVE TILT" : "+POSITIVE TILT";

  // Reset tilt SOS latches once vehicle returns below 35 degrees
  if (maxAbsTilt < 35.0f) {
    tilt60SosLatched = false;
    tilt70RolloverLatched = false;
    tilt60StartMs = 0;
    tilt70StartMs = 0;
  }

  // ---- PRIORITY TILT 1: ROLLOVER DETECTION (>= +70 deg or <= -70 deg) ----
  if (maxAbsTilt >= tiltRolloverDeg) {
    if (tilt70StartMs == 0) tilt70StartMs = now;
    // Hold for 300 ms to confirm true rollover and reject single-sample glitches
    if (!tilt70RolloverLatched && (now - tilt70StartMs >= 300UL)) {
      tilt70RolloverLatched = true;
      tilt60SosLatched = true;
      sbLatched = true;
      cntCrash++;
      snprintf(crashReason, sizeof(crashReason), "ROLLOVER >70D");
      snprintf(sosCustomAlertLine, sizeof(sosCustomAlertLine),
               "CRITICAL ROLLOVER: Tilt %+.1f deg (%s >= 70 deg)! Vehicle rolled/tipped over!",
               signedTilt, tiltDir);
      recordLastEvent("ROLLOVER >70D", "VEHICLE TIPPED OVER", fmaxf(shockShown, currentG), maxAbsTilt);
      Serial.printf("[EMERGENCY] VEHICLE ROLLOVER DETECTED! Signed Tilt=%+.1f deg (%s)\n", signedTilt, tiltDir);
      dispatchSOS("AUTO_ROLLOVER_70DEG", fmaxf(shockShown, currentG), true);
      return;
    }
  } else {
    tilt70StartMs = 0;
  }

  // ---- PRIORITY TILT 2: HIGH TILT (>60 deg in + or - : May Be Crash or Severe Bump) ----
  if (maxAbsTilt >= tiltCrashBumpDeg && maxAbsTilt < tiltRolloverDeg) {
    if (tilt60StartMs == 0) tilt60StartMs = now;
    // Wait 550 ms so if the vehicle is actively rolling past 70 deg, it triggers the 70 deg Rollover above;
    // if it stays between 60 and 70 deg, send the >60 deg "Tilt: May Be Crash or Bump" SOS!
    if (!tilt60SosLatched && (now - tilt60StartMs >= 550UL)) {
      tilt60SosLatched = true;
      sbLatched = true;
      snprintf(crashReason, sizeof(crashReason), "TILT >60D CRASH/BMP");
      snprintf(sosCustomAlertLine, sizeof(sosCustomAlertLine),
               "HIGH TILT ALERT: Tilt %+.1f deg (%s > 60 deg) - May be a Crash or Severe Bump!",
               signedTilt, tiltDir);
      recordLastEvent("TILT >60D ALERT", "MAY BE CRASH/BUMP", fmaxf(shockShown, currentG), maxAbsTilt);
      Serial.printf("[EMERGENCY] HIGH TILT (>60 DEG) DETECTED! Signed Tilt=%+.1f deg (%s)\n", signedTilt, tiltDir);
      dispatchSOS("AUTO_TILT_60DEG", fmaxf(shockShown, currentG), true);
      return;
    }
  } else if (maxAbsTilt < tiltCrashBumpDeg) {
    tilt60StartMs = 0;
  }

  // ---- SPEED BREAKER / BUMP: 25 deg to < 60 deg tilt held for 0.4s ----
  if (moving && maxAbsTilt < tiltCrashBumpDeg) {
    if (!sbLatched) {
      if (tiltDev >= speedBreakerMinTilt) {
        if (sbStart == 0) sbStart = now;
        if (tiltDev > sbPeakTilt) sbPeakTilt = tiltDev;
        // fire once it has been up for SB_HOLD_MS AND has stopped moving (so the angle shown is the final one)
        if (now - sbStart >= SB_HOLD_MS && (tiltRate < 25.0f || now - sbStart >= SB_MAX_WAIT_MS)) {
          sbLatched = true;
          lastRoadEventTime = now;
          windowOpen = false;
          emitSpeedBreaker(sbPeakTilt);
        }
      } else { sbStart = 0; sbPeakTilt = 0; }
    } else if (tiltDev < SB_RELEASE_DEG) {
      sbLatched = false; sbStart = 0; sbPeakTilt = 0;
    }
  }

  // ---- POTHOLE: short sharp shock while the board is NOT being tilted ----
  if (!windowOpen) {
    if (moving && !tiltBusy && !sbLatched && now - lastRoadEventTime >= POTHOLE_DEBOUNCE_MS && peak >= WINDOW_OPEN_G) {
      windowOpen = true; windowStart = now; wMaxG = peak;
    }
  } else {
    if (peak > wMaxG) wMaxG = peak;
    if (now - windowStart >= ROAD_WINDOW_MS) {
      windowOpen = false;
      lastRoadEventTime = now;
      if (tiltBusy || sbLatched) Serial.printf("[MOTION] Ignored: board was being tilted (shock %.2fG)\n", wMaxG);
      else classifyPothole(wMaxG);
    }
  }
}

// ============================================================================
// BUTTON (Multi-Click: 1 Click=Last Event | 2 Clicks=Log | 3 Clicks=15s SOS)
// Uses the physical tactile switch only (active LOW). Capacitive touch backup is disabled to prevent false triggers.
// Press during countdown immediately turns off/cancels the alarm!
// ============================================================================
void checkPhysicalButton() {
  static bool bootGuard = true;
  static bool lastPolledLow = false;
  static unsigned long buttonDownTime = 0;
  static bool holdConsumed = false;

  unsigned long now = millis();

  if (bootGuard) {
    bootGuard = false;
    isrButtonPressQueue = 0;
    Serial.println("[BUTTON] Hardware Interrupt + Debounce active on GPIO" + String(PIN_BUTTON));
    Serial.printf("[BUTTON] Initial digitalRead(GPIO%d)=%d (idle should be HIGH=1)\n",
                  PIN_BUTTON, digitalRead(PIN_BUTTON));
  }

  // Track physical button hold state for 3-second hold backup
  bool currentlyLow = (digitalRead(PIN_BUTTON) == LOW);
  if (currentlyLow && !lastPolledLow) {
    buttonDownTime = now;
    holdConsumed = false;
    if (isrButtonPressQueue == 0 && (micros() - lastIsrFallUs > 60000UL)) {
      lastIsrFallUs = micros();
      isrButtonPressQueue = 1;
    }
  } else if (!currentlyLow) {
    lastPolledLow = false;
  }
  lastPolledLow = currentlyLow;

  // Process all button presses captured by the hardware ISR
  while (isrButtonPressQueue > 0) {
    noInterrupts();
    isrButtonPressQueue--;
    interrupts();

    // 1. If in AUTOMATIC CRASH COUNTDOWN, pressing the button cancels the false alarm
    if (currentState == STATE_CRASH_COUNTDOWN) {
      isrButtonPressQueue = 0;
      sosPressCount = 0;
      cancelAlarm("physical_button");
      return;
    }

    // 2. If SOS was ALREADY DISPATCHED:
    //    Ignore extra clicks for the first 3 seconds so rapid/continuous clicking
    //    NEVER cancels or hides the SOS that was just triggered!
    if (currentState == STATE_SOS_DISPATCHED) {
      isrButtonPressQueue = 0;
      sosPressCount = 0;
      if (now - sosDispatchedAtMs >= 3000UL) {
        dismissSOS();
      } else {
        Serial.println("[BUTTON] Extra click ignored while SOS is sending/active.");
      }
      return;
    }

    // 3. NORMAL STATE: 3-Press Sequence (Reset if > 3 seconds elapsed since previous press)
    if (sosPressCount > 0 && (now - lastSosPressMs > SOS_SEQUENCE_WINDOW_MS)) {
      sosPressCount = 0;
    }

    sosPressCount++;
    lastSosPressMs = now;

    if (sosPressCount == 1) {
      // FIRST PRESS: Display saved Last Event and count first press (1/3)
      playBuzzerPattern(1, 35, 30, 2100);
      Serial.println("[BUTTON] SOS PRESS: 1/3 -> Showing Saved Last Event");
      buttonLastEventRequestId++;
      infoPage = 1;
      infoPageUntil = now + INFO_PAGE_MS;
      oledHoldUntil = 0;
      drawInfoPage(1);

    } else if (sosPressCount == 2) {
      // SECOND PRESS WITHIN 3 SECONDS: Display "SOS PRESS: 2/3" AND Recent Event Log & Details!
      playBuzzerPattern(2, 35, 40, 2400);
      Serial.println("[BUTTON] SOS PRESS: 2/3 -> Showing Event List & Details (Press 1 more time within 3s for SOS)");
      infoPage = 2;
      infoPageUntil = now + INFO_PAGE_MS;
      oledHoldUntil = 0;
      drawInfoPage(2);

    } else if (sosPressCount >= 3) {
      // THIRD PRESS WITHIN 3 SECONDS: Immediately trigger Manual SOS alert!
      isrButtonPressQueue = 0;
      sosPressCount = 0;
      sosCustomAlertLine[0] = 0;
      Serial.println("[BUTTON] SOS PRESS: 3/3 -> TRIGGERING MANUAL SOS IMMEDIATELY!");
      dispatchSOS("MANUAL_3_PRESS", fmaxf(shockShown, currentG), false);
      return;
    }
  }

  // Reset the sequence if the next press does not occur within 3 seconds
  if (sosPressCount > 0 && (now - lastSosPressMs > SOS_SEQUENCE_WINDOW_MS)) {
    Serial.println("[BUTTON] 3-second sequence window expired. Resetting SOS press count to 0/3.");
    sosPressCount = 0;
    if (infoPage == 1 || infoPage == 2) {
      drawInfoPage(infoPage);
    }
  }

  // 3-second continuous hold backup: also triggers SOS directly
  if (currentlyLow && !holdConsumed && currentState == STATE_NORMAL) {
    if (now - buttonDownTime >= 3000UL) {
      holdConsumed = true;
      isrButtonPressQueue = 0;
      sosPressCount = 0;
      sosCustomAlertLine[0] = 0;
      Serial.println("[BUTTON] 3s Hold -> TRIGGERING MANUAL SOS IMMEDIATELY!");
      dispatchSOS("MANUAL_3S_HOLD", fmaxf(shockShown, currentG), false);
    }
  }
}

// ============================================================================
// COMMANDS (Serial + UDP + Bluetooth)
// ============================================================================
void checkIncomingSerialCommands() {
  while (Serial.available() > 0) {
    String line = Serial.readStringUntil('\n');
    line.trim();
    if (line.length() > 0) handleIncomingCommand(line);
  }
}

#if ENABLE_BLUETOOTH
void checkIncomingBtCommands() {
  while (SerialBT.available() > 0) {
    String cmd = SerialBT.readStringUntil('\n');
    cmd.trim();
    if (cmd.length() > 0) {
      Serial.println("[BT RX] " + cmd);
      handleIncomingCommand(cmd);
      SerialBT.println("ACK: " + cmd);
    }
  }
}
#endif

void checkIncomingUdpCommands() {
  if (WiFi.status() != WL_CONNECTED) return;
  int packetSize = udp.parsePacket();
  if (packetSize > 0) {
    char buf[256];
    IPAddress from = udp.remoteIP();
    int len = udp.read(buf, sizeof(buf) - 1);
    if (len <= 0) return;
    if (from == WiFi.localIP()) return;        // ignore our own broadcast
    buf[len] = '\0';
    String cmd = String(buf);
    cmd.trim();
    Serial.println("[UDP RX] " + cmd);
    handleIncomingCommand(cmd);
  }
}

static bool getSetting(const String& s, const char* key, float& out) {
  String k = String(key) + "\":";
  int i = s.indexOf(k);
  if (i < 0) return false;
  out = s.substring(i + k.length()).toFloat();
  return true;
}

static void applySettings(const String& lower) {
  float v;
  if (getSetting(lower, "crash_g", v)          && v >= 1.5f && v <= 10.0f) crashImpactThreshold = v;
  if (getSetting(lower, "minor_pothole_g", v)  && v >= 0.2f && v <= 5.0f)  minorPotholeThreshold = v;
  if (getSetting(lower, "medium_pothole_g", v) && v >= 0.2f && v <= 8.0f)  mediumPotholeThreshold = v;
  if (getSetting(lower, "severe_pothole_g", v) && v >= 0.2f && v <= 8.0f)  severePotholeThreshold = v;
  if (mediumPotholeThreshold < minorPotholeThreshold)  mediumPotholeThreshold = minorPotholeThreshold;
  if (severePotholeThreshold < mediumPotholeThreshold) severePotholeThreshold = mediumPotholeThreshold;
  Serial.println("[SETTINGS] Crash=" + String(crashImpactThreshold, 2) + "G Minor=" + String(minorPotholeThreshold, 2) +
                 "G Medium=" + String(mediumPotholeThreshold, 2) + "G Severe=" + String(severePotholeThreshold, 2) + "G");
}

void handleIncomingCommand(const String& payload) {
  String lower = payload;
  lower.toLowerCase();
  lower.trim();

  // 1) settings FIRST (its text contains "pothole")
  if (lower.indexOf("settings") >= 0) { applySettings(lower); return; }

  // 2) ignore our own output messages if they ever get echoed back
  if (lower.startsWith("{\"type\":\"telemetry\"") || lower.startsWith("{\"type\":\"crash_detected\"") ||
      lower.startsWith("{\"type\":\"pothole\"")   || lower.startsWith("{\"type\":\"bump\"") ||
      lower.startsWith("{\"type\":\"speed_breaker\"") || lower.startsWith("{\"type\":\"countdown\"") ||
      lower.startsWith("{\"type\":\"button_ping\"") || lower.startsWith("{\"type\":\"last_event\"") ||
      lower.indexOf("\"mode\"") >= 0 || lower.indexOf("\"reason\"") >= 0) return;

  // 3) commands
  if (lower == "gpsraw") {
    gpsRaw = !gpsRaw;
    Serial.println(String("[GPS] raw sentence printing ") + (gpsRaw ? "ON" : "OFF"));
  } else if (lower == "cal" || lower.indexOf("calibrate") >= 0) {
    requestCalibration();
  } else if (lower == "info") {
    printStatus();
    if (calibrated && currentState == STATE_NORMAL) nextInfoPage();
  } else if (lower.indexOf("cancel") >= 0) {
    if (currentState == STATE_SOS_DISPATCHED) dismissSOS(); else cancelAlarm("command");
  } else if (lower.indexOf("sos") >= 0) {
    sosCustomAlertLine[0] = 0;
    dispatchSOS("COMMAND_SOS", fmaxf(shockShown, currentG), false);
  } else if (lower.indexOf("crash") >= 0) {
    startCrash("SIMULATED", 5.2f);
  } else if (lower.indexOf("speed") >= 0) {
    emitSpeedBreaker(30.0f);
  } else if (lower.indexOf("pothole") >= 0) {
    int level = (lower.indexOf("minor") >= 0) ? 1 : (lower.indexOf("medium") >= 0) ? 2 : 3;
    emitPothole(level, level == 1 ? 1.50f : (level == 2 ? 2.20f : 3.00f), false);
  } else if (lower.indexOf("bump") >= 0) {
    emitPothole(1, 1.50f, false);
  }
}

