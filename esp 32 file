void oled_render_char(int x, int page, char c) {
  if (c >= 'a' && c <= 'z') c = c - 'a' + 'A';
  if (c < 32 || c > 90) c = ' ';
  int idx = (c - 32) * 5;
  for (int i = 0; i < 5; i++)
    if (x + i < 128) oled_buffer[page * 128 + x + i] = pgm_read_byte(&font5x7[idx + i]);
}

void oled_draw_string(int x, int page, const char* str) {   // max 21 chars per line
  int cx = x;
  while (*str && cx < 124) { oled_render_char(cx, page, *str++); cx += 6; }
}

void oledPrintf(int x, int row, const char* fmt, ...) {
  char b[48];
  va_list ap;
  va_start(ap, fmt);
  vsnprintf(b, sizeof(b), fmt, ap);
  va_end(ap);
  oled_draw_string(x, row, b);
}

void oled_send_buffer() {
  ssd1306_cmd(0x21); ssd1306_cmd(0); ssd1306_cmd(127);   // column range
  ssd1306_cmd(0x22); ssd1306_cmd(0); ssd1306_cmd(7);     // page range
  for (int i = 0; i < 1024; i += 32) {
    if (i > 0) readMPU6050();                        // sample after EVERY chunk so a short knock is never missed during a redraw
    Wire.beginTransmission(oledAddress);
    Wire.write(0x40);
    Wire.write(&oled_buffer[i], 32);
    if (Wire.endTransmission() != 0) {
      if (++oledFail >= 2) { oledAvailable = false; recoverI2CBus(); Serial.println("[OLED] Re-syncing display after power switch..."); }
      return;
    }
  }
  oledFail = 0;
}

static const uint8_t oled_init_seq[] PROGMEM = {
  0xAE, 0xD5, 0x80, 0xA8, 0x3F, 0xD3, 0x00, 0x40,
  0x8D, 0x14, 0x20, 0x00, 0xA1, 0xC8, 0xDA, 0x12,
  0x81, 0xCF, 0xD9, 0xF1, 0xDB, 0x40, 0xA4, 0xA6, 0xAF
};
void oledSendInit() {
  for (size_t i = 0; i < sizeof(oled_init_seq); i++) ssd1306_cmd(pgm_read_byte(&oled_init_seq[i]));
}

void initOLED() {
  Wire.beginTransmission(0x3C); byte e3C = Wire.endTransmission();
  Wire.beginTransmission(0x3D); byte e3D = Wire.endTransmission();
  if (e3C == 0)      oledAddress = 0x3C;
  else if (e3D == 0) oledAddress = 0x3D;
  else { oledAvailable = false; return; }

  oledSendInit();
  oledAvailable = true;
  oledFail = 0;
  Serial.printf("[OLED] SSD1306 ready at 0x%02X\n", oledAddress);

  memset(oled_buffer, 0, sizeof(oled_buffer));
  oled_draw_string(14, 1, "AEGIS RIDE IOT");
  oled_draw_string(8, 3, "SPEED BREAKER AI");
  oled_draw_string(20, 5, "STATUS: ARMED");
  oled_send_buffer();
  oledHoldUntil = millis() + 1500;     // non-blocking splash
}

static void gpsStatusLine(char* out, size_t n) {
  if (hasGPSFix)                                                    snprintf(out, n, "GPS: FIX %d SATS", realSatellites);
  else if (totalGpsBytes == 0 || millis() - lastGpsByteTime > 3000) snprintf(out, n, "GPS NO DATA-CHK WIRE");
  else if (gpsGoodSentences == 0)                                   snprintf(out, n, "GPS BAD DATA (BAUD?)");
  else                                                              snprintf(out, n, "GPS SEARCH SAT:%d", satsInView);
}

void updateOledTelemetry() {
  if (!oledAvailable || millis() < oledHoldUntil) return;

  if (!calibrated)                              { showOledCalibrating(); return; }
  if (currentState == STATE_CRASH_COUNTDOWN)    { showOledCrashCountdown(countdownSeconds); return; }
  if (currentState == STATE_SOS_DISPATCHED) {
    if (millis() >= sosStatusShownUntilMs) {
      currentState = STATE_NORMAL;
    } else {
      showOledSosDispatched();
      return;
    }
  }
  if (infoPage > 0) {
    if (millis() >= infoPageUntil) {
      infoPage = 0;
      oledHoldUntil = 0;
    } else {
      drawInfoPage(infoPage);
      return;
    }
  }

  memset(oled_buffer, 0, sizeof(oled_buffer));
  char b[32];

  // Row 0: System Armed + Wi-Fi Internet Status ("WIFI:OK" or "WIFI:NO")
  oledPrintf(2, 0, "AEGIS RIDE  WIFI:%s", (WiFi.status() == WL_CONNECTED) ? "OK" : "NO");

  // Row 1: Live 3-Axis Motion (X, Y, Z in G)
  if (mpuConnected) {
    oledPrintf(2, 1, "X:%+.1f Y:%+.1f Z:%+.1fG", ax_g, ay_g, az_g);
    // Row 2: Total G-Force & Dynamic Shock G
    oledPrintf(2, 2, "G:%.2f  SHOCK:%.2fG", currentG, shockShown);
  } else {
    oled_draw_string(2, 1, "MPU6050 NOT FOUND");
    oled_draw_string(2, 2, "CHECK SDA21 SCL22");
  }

  // Row 3: Signed Calibrated Tilt Angle (+ or -, 0D when resting flat!) & Speed
  float dP = ay_g - refY, dR = ax_g - refX;
  bool negT = (fabsf(dP) >= fabsf(dR)) ? (dP < 0.0f) : (dR < 0.0f);
  int signedT = negT ? -(int)(tiltDev + 0.5f) : +(int)(tiltDev + 0.5f);
  oledPrintf(2, 3, "TILT:%+dD SPD:%dKM/H", signedT, (int)curSpeedKmh());

  // Row 4: Battery Percentage & Voltage
  oledPrintf(2, 4, "BAT:%d%% (%.2fV) %s",
             batteryPercentage, batteryVoltage, isBatteryConnected ? "" : "USB");

  // Row 5: Current Rider Location Coordinates (Method 3 Auto GPS)
  oledPrintf(2, 5, "LOC:%.4f,%.4f", getEffectiveLat(), getEffectiveLng());

  // Row 6: Button Guide (1 Click=Last Event, 2 Clicks=Details, 3 Clicks=SOS)
  oled_draw_string(2, 6, "1:EVT 2:LIST 3:SOS");

  // Row 7: Saved Last Event
  const EvtRec* e = newestEvt(0);
  oledPrintf(2, 7, "LAST: %s", e ? e->tag : "NONE");

  oled_send_buffer();
}

