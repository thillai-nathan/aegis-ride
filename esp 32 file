// Unsticks I2C devices (OLED + MPU6050) when switching between USB and Battery power
void recoverI2CBus() {
  pinMode(PIN_SDA, INPUT_PULLUP);
  pinMode(PIN_SCL, OUTPUT);
  for (int i = 0; i < 9; i++) {
    digitalWrite(PIN_SCL, LOW);  delayMicroseconds(10);
    digitalWrite(PIN_SCL, HIGH); delayMicroseconds(10);
  }
  Wire.end();
  delay(15);
  Wire.begin(PIN_SDA, PIN_SCL, I2C_CLOCK_HZ);
  Wire.setTimeOut(50);
}

void setup() {
#ifdef RTC_CNTL_BROWN_OUT_REG
  WRITE_PERI_REG(RTC_CNTL_BROWN_OUT_REG, 0); // Disable brownout reset on battery current spikes
#endif
  Serial.begin(115200);
  Serial.setTimeout(20);
  delay(400); // Let battery voltage stabilize before I2C init
  Serial.println("\n=== AEGIS RIDE v4.3 (Instant Battery Boot + No Auto-SOS on Reset) ===");

  pinMode(PIN_BUZZER, OUTPUT);  digitalWrite(PIN_BUZZER, LOW);
  pinMode(PIN_LED, OUTPUT);     digitalWrite(PIN_LED, LOW);
  pinMode(PIN_BUTTON, INPUT_PULLUP);
  pinMode(PIN_BATTERY_ADC, INPUT);
  readBattery();

  // Recover I2C bus and initialize OLED twice so battery power-on never leaves screen blank
  recoverI2CBus();
  initMPU6050();
  initOLED();
  if (!oledAvailable) { delay(150); recoverI2CBus(); initOLED(); }
  showWelcomeScreen();
  delay(800);

  // Fast 1.5-second calibration that NEVER gets stuck even on battery power!
  {
    unsigned long tc = millis();
    showOledCalibrating();
    while (mpuConnected && !calibrated && millis() - tc < 1800UL) { readMPU6050(); delay(4); }
    if (!calibrated) {
      float mag = sqrtf(ax_g * ax_g + ay_g * ay_g + az_g * az_g);
      if (mag < 0.2f) { ax_g = 0; ay_g = 0; az_g = 1.0f; mag = 1.0f; }
      refX = ax_g / mag; refY = ay_g / mag; refZ = az_g / mag; refMag = mag;
      gSx = ax_g; gSy = ay_g; gSz = az_g;
      tiltDev = 0; dynG = 0; shockShown = 0; peakDyn = 0;
      calibrated = true;
    }
    calibratedAtMs = millis();
    oledHoldUntil = 0;
  }

  gpsSerial.setRxBufferSize(1024);
  gpsSerial.begin(GPS_BAUDS[0], SERIAL_8N1, PIN_GPS_RX, PIN_GPS_TX);

  // Start Wi-Fi AP + Hotspot connection WITHOUT long blocking delays so battery boot is instant!
  WiFi.persistent(false);
  WiFi.disconnect(true);
  delay(50);
  WiFi.mode(WIFI_AP_STA);
  WiFi.setTxPower(WIFI_POWER_11dBm); // Battery-safe TX power

  IPAddress apIP(192, 168, 4, 1);
  IPAddress apGW(192, 168, 4, 1);
  IPAddress apSub(255, 255, 255, 0);
  WiFi.softAPConfig(apIP, apGW, apSub);
  WiFi.softAP(AP_SSID, AP_PASS, 1, 0, 4);

  if (String(WIFI_SSID).length() > 0 && String(WIFI_SSID) != "YOUR_INTERNET_HOTSPOT_NAME") {
    Serial.printf("[WIFI STA] Connecting to '%s' in background...\n", WIFI_SSID);
    WiFi.begin(WIFI_SSID, WIFI_PASS);
    // Wait at most 2.5 seconds in setup(); if hotspot takes longer, loop() finishes connecting non-blockingly!
    unsigned long t0 = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - t0 < 2500UL) {
      delay(100);
      readMPU6050();
    }
  }

  setupWebServer();

  // Attach button interrupt AFTER setup() finishes so power-on/reset noise never queues false clicks!
  isrButtonPressQueue = 0;
  sosPressCount = 0;
  attachInterrupt(digitalPinToInterrupt(PIN_BUTTON), onSosButtonISR, FALLING);

  digitalWrite(PIN_BUZZER, HIGH); delay(60); digitalWrite(PIN_BUZZER, LOW); delay(60);
  digitalWrite(PIN_BUZZER, HIGH); delay(90); digitalWrite(PIN_BUZZER, LOW);
  updateOledTelemetry(); // Draw main home screen immediately!
  Serial.println("[SYSTEM] Ready! (1 Click: Last Event | 2 Clicks: Event Details | 3 Clicks: Send SOS)");
}

// ============================================================================
// LOOP  (no long delay() calls so MPU / GPS / button / web are never starved)
// ============================================================================
void loop() {
  server.handleClient();

#if ENABLE_BLUETOOTH
  checkIncomingBtCommands();
#endif

  static unsigned long lastWifiCheck = 0;
  static bool udpActive = false;
  if (WiFi.status() == WL_CONNECTED && !initialLocFetched) {
    initialLocFetched = true;
    MDNS.begin("aegis");
    udp.begin(8888);
    udpActive = true;
    Serial.println("[WIFI STA] Connected! IP: " + WiFi.localIP().toString());
    // Method 3: Automatically fetch accurate location in the background (NO SOS sent on boot!)
    fetchNetworkCurrentLocation();
    fetchTelegramLocationPin();
  }
  if (millis() - lastWifiCheck > 12000) {
    lastWifiCheck = millis();
    if (WiFi.status() != WL_CONNECTED) {
      udpActive = false;
      if (String(WIFI_SSID).length() > 0 && String(WIFI_SSID) != "YOUR_INTERNET_HOTSPOT_NAME") {
        WiFi.begin(WIFI_SSID, WIFI_PASS);
      }
    }
  }

  if (millis() - lastBatteryCheck >= 1000) { lastBatteryCheck = millis(); readBattery(); }

  static unsigned long lastMpuCheck = 0;
  if (!mpuConnected && millis() - lastMpuCheck >= 2000) { lastMpuCheck = millis(); initMPU6050(); }

  static unsigned long lastOledCheck = 0;
  if (!oledAvailable && millis() - lastOledCheck >= 1500) {
    lastOledCheck = millis();
    recoverI2CBus();
    initOLED();
  }

  static unsigned long lastOledReinit = 0;
  if (oledAvailable && !windowOpen && millis() - lastOledReinit > 3000) {
    lastOledReinit = millis();
    oledSendInit(); // Auto-wakes OLED within 3s if USB was unplugged while running on battery
  }

  readMPU6050();
  readGPSModule();
  checkPhysicalButton();
  checkIncomingSerialCommands();
  checkIncomingUdpCommands();
  checkMotionEvents();
  updateCrashCountdown();
  serviceSosRetry();
  updateBuzzer();

  // 10 Hz telemetry
  if (millis() - lastTelemetryStream >= 100) {
    lastTelemetryStream = millis();
    digitalWrite(PIN_LED, (millis() / 500) % 2);
    String json = "{";
    json += "\"type\":\"telemetry\",";
    json += "\"speed\":" + String(curSpeedKmh(), 1) + ",";
    json += "\"g_force\":" + String(currentG, 2) + ",";
    json += "\"pitch\":" + String(pitchDeg, 1) + ",";
    json += "\"roll\":" + String(rollDeg, 1) + ",";
    json += "\"tilt\":" + String(tiltDev, 1) + ",";
    json += "\"battery\":" + String(batteryPercentage) + ",";
    json += "\"battery_v\":" + String(batteryVoltage, 2) + ",";
    json += "\"lat\":" + String(getEffectiveLat(), 6) + ",";
    json += "\"lng\":" + String(getEffectiveLng(), 6) + ",";
    json += "\"satellites\":" + String(realSatellites) + ",";
    json += "\"gps_fix\":" + String(hasGPSFix ? "true" : "false") + ",";
    json += "\"state\":" + String((int)currentState);
    json += "}";
    broadcastJSON(json);
  }

  // OLED refresh - skipped while a shock is being measured (I2C is busy otherwise)
  if (!windowOpen && !pendingCrash && millis() - lastOledRefresh >= 400) {
    lastOledRefresh = millis();
    updateOledTelemetry();
  }
}

// ============================================================================
// MPU-6050
// ============================================================================
static int16_t read16() {            // explicit order: C++ does NOT guarantee left-to-right evaluation
  uint8_t hi = Wire.read();
  uint8_t lo = Wire.read();
  return (int16_t)((hi << 8) | lo);
}

void initMPU6050() {
  Wire.beginTransmission(0x68); byte e68 = Wire.endTransmission();
  Wire.beginTransmission(0x69); byte e69 = Wire.endTransmission();
  if (e68 == 0)      { mpuAddress = 0x68; }
  else if (e69 == 0) { mpuAddress = 0x69; }
  else {
    if (mpuConnected) Serial.println("[MPU6050 ERROR] Lost sensor. Check SDA:21 SCL:22.");
    mpuConnected = false;
    return;
  }

  Wire.beginTransmission(mpuAddress); Wire.write(0x6B); Wire.write(0x80); Wire.endTransmission(); // reset
  delay(100);
  Wire.beginTransmission(mpuAddress); Wire.write(0x6B); Wire.write(0x01); Wire.endTransmission(); // wake
  delay(30);
  Wire.beginTransmission(mpuAddress); Wire.write(0x1A); Wire.write(0x02); Wire.endTransmission(); // DLPF ~94 Hz
  Wire.beginTransmission(mpuAddress); Wire.write(0x1C); Wire.write(0x18); Wire.endTransmission(); // +/-16g (required for >= 10G standalone crash detection)
  delay(20);

  Wire.beginTransmission(mpuAddress); Wire.write(0x1C); Wire.endTransmission(false);
  Wire.requestFrom((uint8_t)mpuAddress, (size_t)1, true);
  if (!Wire.available()) { mpuConnected = false; Serial.println("[MPU6050] Config read-back failed, retrying..."); return; }
  uint8_t reg1C = Wire.read();
  uint8_t afs = (reg1C >> 3) & 0x03;
  const float div[4] = {16384.0f, 8192.0f, 4096.0f, 2048.0f};
  accelScaleDivisor = div[afs];
  mpuConnected = true;
  mpuFailCount = 0;
  Serial.printf("[MPU6050] Connected at 0x%02X, reg1C=0x%02X, %.0f LSB/g\n", mpuAddress, reg1C, accelScaleDivisor);
  requestCalibration();
}

void requestCalibration() {
  calibrated = false; calRestart = true;
  windowOpen = false; pendingCrash = false; sbLatched = false; sbStart = 0;
  highDynCount = 0; crashImpactSeen = false; crashImpactPeak = 0; peakDyn = 0;
  infoPage = 0; oledHoldUntil = 0;
  Serial.println("[CAL] Calibrating - keep the board FLAT and STILL for 2 seconds...");
}

// Averages the resting gravity vector. Restarts if the board moves.
static void calibrationStep() {
  static unsigned long calStart = 0;
  static double sx = 0, sy = 0, sz = 0;
  static unsigned int n = 0;
  static float gmin = 99, gmax = 0;
  static unsigned long lastCalMs = 0;
  unsigned long now = millis();
  if (calRestart || (lastCalMs != 0 && now - lastCalMs > 300)) { calStart = 0; calRestart = false; }   // restart silently after a gap in sampling
  lastCalMs = now;
  if (calStart == 0) { calStart = now; sx = sy = sz = 0; n = 0; gmin = 99; gmax = 0; }
  sx += ax_g; sy += ay_g; sz += az_g; n++;
  if (currentG < gmin) gmin = currentG;
  if (currentG > gmax) gmax = currentG;
  if (now - calStart >= CAL_MS) {
    double mx = sx / n, my = sy / n, mz = sz / n;
    double mag = sqrt(mx * mx + my * my + mz * mz);
    if (n >= 40 && (gmax - gmin) < 0.20f && mag > 0.6 && mag < 1.5) {
      refX = (float)(mx / mag); refY = (float)(my / mag); refZ = (float)(mz / mag);
      refMag = (float)mag;
      gSx = (float)mx; gSy = (float)my; gSz = (float)mz;
      tiltDev = 0; dynG = 0; shockShown = 0; peakDyn = 0;
      calibrated = true;
      calibratedAtMs = millis();
      calStart = 0;
      oledHoldUntil = 0;
      Serial.printf("[CAL] Done. Flat = (%.2f, %.2f, %.2f) g, |g|=%.2f. Events are now ARMED.\n", refX * refMag, refY * refMag, refZ * refMag, refMag);
    } else {
      Serial.println("[CAL] Board moved during calibration - keep it still. Retrying...");
      calStart = 0;
    }
  }
}

void readMPU6050() {
  if (!mpuConnected) return;

  Wire.beginTransmission(mpuAddress);
  Wire.write(0x3B);
  if (Wire.endTransmission(false) != 0) { if (++mpuFailCount >= 10) { mpuConnected = false; Serial.println("[MPU6050 ERROR] Sensor lost!"); } return; }
  size_t got = Wire.requestFrom((uint8_t)mpuAddress, (size_t)14, true);
  if (got < 14) { if (++mpuFailCount >= 10) { mpuConnected = false; Serial.println("[MPU6050 ERROR] Sensor lost!"); } return; }
  mpuFailCount = 0;

  int16_t rawAx = read16();
  int16_t rawAy = read16();
  int16_t rawAz = read16();
  read16();                         // temperature
  read16(); read16(); read16();     // gyro (unused)

  static uint16_t zeroCount = 0, stuckCount = 0;
  static int16_t lAx = 0, lAy = 0, lAz = 0;
  if (rawAx == 0 && rawAy == 0 && rawAz == 0) {            // sensor reset to sleep after a power dip
    if (++zeroCount >= 30) { zeroCount = 0; Serial.println("[MPU6050] All-zero data (sensor reset?) -> re-initializing"); initMPU6050(); }
    return;
  }
  zeroCount = 0;
  if (rawAx == lAx && rawAy == lAy && rawAz == lAz) {      // frozen output
    if (++stuckCount >= 300) { stuckCount = 0; Serial.println("[MPU6050] Data frozen -> re-initializing"); initMPU6050(); return; }
  } else stuckCount = 0;
  lAx = rawAx; lAy = rawAy; lAz = rawAz;

  ax_g = rawAx / accelScaleDivisor;
  ay_g = rawAy / accelScaleDivisor;
  az_g = rawAz / accelScaleDivisor;
  currentG = sqrtf(ax_g * ax_g + ay_g * ay_g + az_g * az_g);
  pitchDeg = atan2f(ay_g, sqrtf(ax_g * ax_g + az_g * az_g)) * 180.0f / PI;
  rollDeg  = atan2f(-ax_g, az_g) * 180.0f / PI;

  static unsigned long lastUs = 0;
  unsigned long nowUs = micros();
  float dt = (nowUs - lastUs) / 1e6f;
  lastUs = nowUs;
  if (dt > 0.2f) dt = 0.2f;
  if (dt < 0)    dt = 0;

  if (!calibrated) { calibrationStep(); return; }

  // Gravity estimate: follows slow tilting, but is frozen while |a| is far from
  // 1 g (i.e. during a knock / drop), so shocks never pollute the tilt angle.
  if (fabsf(currentG - refMag) < QS_GATE_G) {
    float a = dt / (dt + 0.12f);
    gSx += a * (ax_g - gSx);
    gSy += a * (ay_g - gSy);
    gSz += a * (az_g - gSz);
  }

  // SHOCK = what is left after removing gravity
  float dx = ax_g - gSx, dy = ay_g - gSy, dz = az_g - gSz;
  dynG = sqrtf(dx * dx + dy * dy + dz * dz);
  if (dynG > peakDyn) peakDyn = dynG;
  shockShown = fmaxf(dynG, shockShown * (1.0f - fminf(dt / 0.8f, 1.0f)));

  // TILT = angle between current gravity and the calibrated flat position
  float gm = sqrtf(gSx * gSx + gSy * gSy + gSz * gSz);
  if (gm > 0.3f) {
    float c = (gSx * refX + gSy * refY + gSz * refZ) / gm;
    if (c > 1) c = 1;
    if (c < -1) c = -1;
    tiltDev = acosf(c) * 180.0f / PI;
  }

  // Trigger standalone crash immediately whenever dynamic shock (dynG) or total G (currentG) reaches >= 10.0 G!
  float maxForceNow = fmaxf(dynG, currentG);
  if (maxForceNow >= crashImpactThreshold) {
    crashImpactSeen = true;
    if (maxForceNow > crashImpactPeak) crashImpactPeak = maxForceNow;
  }
}

// ============================================================================
// EVENT RECORD / EMIT
// ============================================================================
void recordLastEvent(const char* tag, const char* sub, float g, float tilt) {
  EvtRec& e = evtLog[evtCount % EVT_LOG_SIZE];
  strncpy(e.tag, tag, sizeof(e.tag) - 1); e.tag[sizeof(e.tag) - 1] = 0;
  strncpy(e.sub, sub, sizeof(e.sub) - 1); e.sub[sizeof(e.sub) - 1] = 0;
  e.g = g; e.tilt = tilt; e.t = millis();
  evtCount++;
}

static const EvtRec* newestEvt(unsigned int i) {      // i = 0 is the latest event
  if (i >= evtCount || i >= EVT_LOG_SIZE) return NULL;
  return &evtLog[(evtCount - 1 - i) % EVT_LOG_SIZE];
}

void emitPothole(int level, float g, bool hardHit) {
  const char* tag = (level >= 3) ? "SEVERE POTHOLE" : (level == 2) ? "MEDIUM POTHOLE" : "MINOR POTHOLE";
  const char* sub = (level >= 3) ? (hardHit ? "HARD HIT-NO CRASH" : "DEEP CRATER")
                  : (level == 2) ? "ROUGH ROAD" : "SMALL DIP";
  const char* sev = (level >= 3) ? "severe" : (level == 2) ? "medium" : "minor";
  if (level >= 3) cntSevere++; else if (level == 2) cntMedium++; else cntMinor++;
  if (g > maxShockG) maxShockG = g;
  if (ROAD_EVENT_BEEP) playBuzzerPattern(1, 90, 50, 1900);             // Crisp single road-hazard beep

  recordLastEvent(tag, sub, g, tiltDev);
  Serial.println(String("[ROAD EVENT] ") + tag + " | Peak " + String(g, 2) + "G");
  char d[24]; snprintf(d, sizeof(d), "SHOCK: %.2fG", g);
  showOledRoadEvent(tag, sub, d);

  String evt = "{";
  evt += "\"type\":\"pothole\",";
  evt += "\"severity\":\"" + String(sev) + "\",";
  evt += "\"level\":" + String(level) + ",";
  evt += "\"g_force\":" + String(g, 2) + ",";
  evt += "\"pitch\":" + String(tiltDev, 1) + ",";
  evt += "\"lat\":" + String(realLat, 6) + ",";
  evt += "\"lng\":" + String(realLng, 6);
  evt += "}";
  broadcastJSON(evt);
}

void emitSpeedBreaker(float tilt) {
  cntSpeedBreaker++;
  if (shockShown > maxShockG) maxShockG = shockShown;
  if (ROAD_EVENT_BEEP) playBuzzerPattern(1, 90, 50, 1900);             // Crisp single road-hazard beep

  recordLastEvent("SPEED BREAKER", "BUMP - SLOW DOWN", shockShown, tilt);
  Serial.println(String("[ROAD EVENT] SPEED BREAKER | Tilt ") + String(tilt, 1) + " deg");
  char d[24]; snprintf(d, sizeof(d), "TILT: %d DEG", (int)(tilt + 0.5f));
  showOledRoadEvent("SPEED BREAKER", "BUMP - SLOW DOWN", d);

  String evt = "{";
  evt += "\"type\":\"speed_breaker\",";
  evt += "\"severity\":\"minor\",";
  evt += "\"g_force\":" + String(shockShown, 2) + ",";
  evt += "\"pitch\":" + String(tilt, 1) + ",";
  evt += "\"tilt\":" + String(tilt, 1) + ",";
  evt += "\"lat\":" + String(realLat, 6) + ",";
  evt += "\"lng\":" + String(realLng, 6);
  evt += "}";
  broadcastJSON(evt);
}

