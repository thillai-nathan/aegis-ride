static String urlEncode(const String& s) {
  String out;
  const char* hex = "0123456789ABCDEF";
  for (unsigned int i = 0; i < s.length(); i++) {
    char c = s.charAt(i);
    if ((c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '-' || c == '_' || c == '.' || c == '~') out += c;
    else if (c == ' ') out += '+';
    else { out += '%'; out += hex[(c >> 4) & 15]; out += hex[c & 15]; }
  }
  return out;
}

String buildSosText() {
  const EvtRec* lastEvt = newestEvt(0);
  float dPitch = ay_g - refY;
  float dRoll  = ax_g - refX;
  bool isNeg = (fabsf(dPitch) >= fabsf(dRoll)) ? (dPitch < 0.0f) : (dRoll < 0.0f);
  float signedTilt = isNeg ? -tiltDev : +tiltDev;

  String evtName;
  if (sosCustomAlertLine[0] != 0) {
    evtName = String(sosCustomAlertLine);
  } else if (tiltDev >= tiltRolloverDeg) {
    evtName = "CRITICAL VEHICLE ROLLOVER (>= +/-70 DEG) - Vehicle tipped/rolled over!";
  } else if (tiltDev >= tiltCrashBumpDeg) {
    evtName = "HIGH TILT ALERT (>= +/-60 DEG) - Tilt may be a Crash or Severe Bump!";
  } else if (sosIsCrash) {
    evtName = String("AUTOMATIC CRASH (") + String(crashReason) + ")";
  } else {
    evtName = String("MANUAL 3-CLICK SOS (Last Event: ") + String(lastEvt ? lastEvt->tag : "NONE") + ")";
  }

  String msg = "AEGIS RIDE EMERGENCY SOS\n";
  msg += "Event: " + evtName + "\n";
  msg += "Tilt: " + String(signedTilt, 1) + " deg\n";
  msg += "Impact Force: " + String(sosG, 2) + " G | Speed: " + String(curSpeedKmh(), 1) + " km/h\n";
  msg += "Battery: " + String(batteryPercentage) + "% (" + String(batteryVoltage, 2) + " V)\n";

  double lat = getEffectiveLat();
  double lng = getEffectiveLng();
  msg += "Rider Current Location: " + String(riderAreaName) + "\n";
  msg += "Current Coords: " + String(lat, 6) + ", " + String(lng, 6) + "\n";
  msg += "Location Source: " + String(getLocationSourceTag()) + "\n";
  msg += "Google Maps Pin: https://maps.google.com/?q=" + String(lat, 6) + "," + String(lng, 6);
  return msg;
}

static bool telegramConfigured() {
  return TELEGRAM_BOT_TOKEN[0] && TELEGRAM_CHAT_ID[0] &&
         String(TELEGRAM_BOT_TOKEN) != "YOUR_TELEGRAM_BOT_TOKEN" &&
         String(TELEGRAM_CHAT_ID) != "YOUR_TELEGRAM_CHAT_ID";
}

bool sendTelegramSOS(const String& msg) {
  if (!telegramConfigured()) {
    snprintf(sosDetail, sizeof(sosDetail), "SET TOKEN/CHAT ID");
    Serial.println("[TELEGRAM] Not configured. Set TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID.");
    return false;
  }
  if (WiFi.status() != WL_CONNECTED) {
    snprintf(sosDetail, sizeof(sosDetail), "WIFI THILLAI OFF");
    Serial.println("[TELEGRAM] No internet on Wi-Fi station; SOS cannot reach Telegram.");
    return false;
  }
  Serial.printf("[TELEGRAM] Free heap before HTTPS: %u bytes\n", ESP.getFreeHeap());
  WiFiClientSecure client;
  client.setInsecure();
  client.setTimeout(6000);
  HTTPClient http;
  http.setTimeout(6000);
  String url = "https://api.telegram.org/bot" + String(TELEGRAM_BOT_TOKEN) + "/sendMessage";
  String body = "chat_id=" + urlEncode(String(TELEGRAM_CHAT_ID)) + "&text=" + urlEncode(msg);
  bool ok = false;
  if (http.begin(client, url)) {
    http.addHeader("Content-Type", "application/x-www-form-urlencoded");
    int code = http.POST(body);
    String response = http.getString();
    ok = (code == 200 && response.indexOf("\"ok\":true") >= 0);
    Serial.printf("[TELEGRAM] sendMessage HTTP status: %d\n", code);
    Serial.println(String("[TELEGRAM] API response: ") + response);
    if (ok) {
      snprintf(sosDetail, sizeof(sosDetail), "DELIVERED TO TG!");
    } else if (code == 400) {
      snprintf(sosDetail, sizeof(sosDetail), "TG 400: START BOT");
    } else if (code == 401 || code == 404) {
      snprintf(sosDetail, sizeof(sosDetail), "TG %d: BAD TOKEN", code);
    } else if (code < 0) {
      snprintf(sosDetail, sizeof(sosDetail), "NO INTERNET DATA");
    } else {
      snprintf(sosDetail, sizeof(sosDetail), "TG HTTP ERR: %d", code);
    }
    http.end();
  } else {
    snprintf(sosDetail, sizeof(sosDetail), "HTTPS INIT FAILED");
    Serial.println("[TELEGRAM] Could not start HTTPS request.");
  }
  return ok;
}

// Checks if you ever sent a Location Pin in your Telegram Bot chat (persists across ESP32 resets!)
void fetchTelegramLocationPin() {
  if (!telegramConfigured() || WiFi.status() != WL_CONNECTED) return;
  WiFiClientSecure client;
  client.setInsecure();
  client.setTimeout(3500);
  HTTPClient http;
  http.setTimeout(3500);
  String url = "https://api.telegram.org/bot" + String(TELEGRAM_BOT_TOKEN) + "/getUpdates?offset=-5&limit=5";
  if (http.begin(client, url)) {
    int code = http.GET();
    if (code == 200) {
      String res = http.getString();
      int locIdx = res.lastIndexOf("\"location\":{");
      if (locIdx >= 0) {
        int latIdx = res.indexOf("\"latitude\":", locIdx);
        int lngIdx = res.indexOf("\"longitude\":", locIdx);
        if (latIdx >= 0 && lngIdx >= 0) {
          double tLat = res.substring(latIdx + 11).toDouble();
          double tLng = res.substring(lngIdx + 12).toDouble();
          if (tLat != 0.0 && tLng != 0.0 && fabs(tLat) <= 90.0 && fabs(tLng) <= 180.0) {
            phoneLat = tLat;
            phoneLng = tLng;
            hasPhoneFix = true;
            hasTelegramPin = true;
            strncpy(riderAreaName, "Exact GPS Pin (Chennai)", sizeof(riderAreaName) - 1);
            Serial.printf("[TG GPS PIN] Exact Phone GPS locked: %.6f, %.6f\n", phoneLat, phoneLng);
          }
        }
      }
    }
    http.end();
  }
}

// Method 3: Automatically fetches the rider's current latitude/longitude & area from the Hotspot internet connection
void fetchNetworkCurrentLocation() {
  if (WiFi.status() != WL_CONNECTED || hasGPSFix || hasPhoneFix) return;
  HTTPClient http;
  http.setTimeout(3500);
  if (http.begin("http://ip-api.com/line/?fields=status,city,regionName,district,lat,lon")) {
    int code = http.GET();
    if (code == 200) {
      String payload = http.getString();
      int l1 = payload.indexOf('\n');
      String status = (l1 > 0) ? payload.substring(0, l1) : "";
      status.trim();
      if (status == "success") {
        int l2 = payload.indexOf('\n', l1 + 1);
        int l3 = payload.indexOf('\n', l2 + 1);
        int l4 = payload.indexOf('\n', l3 + 1);
        int l5 = payload.indexOf('\n', l4 + 1);
        int l6 = payload.indexOf('\n', l5 + 1);
        if (l2 > 0 && l3 > 0 && l4 > 0 && l5 > 0) {
          String city     = payload.substring(l1 + 1, l2); city.trim();
          String region   = payload.substring(l2 + 1, l3); region.trim();
          String district = payload.substring(l3 + 1, l4); district.trim();
          double fLat     = payload.substring(l4 + 1, l5).toDouble();
          double fLng     = (l6 > 0 ? payload.substring(l5 + 1, l6) : payload.substring(l5 + 1)).toDouble();
          if (fLat != 0.0 && fLng != 0.0) {
            netLat = fLat;
            netLng = fLng;
            hasNetLocation = true;
            String area = (district.length() > 0 && district != city) ? (district + ", " + city) : (city + ", " + region);
            strncpy(riderAreaName, area.c_str(), sizeof(riderAreaName) - 1);
            riderAreaName[sizeof(riderAreaName) - 1] = 0;
            Serial.printf("[METHOD 3 AUTO GPS] Rider Current Location: %s (%.6f, %.6f)\n",
                          riderAreaName, netLat, netLng);
          }
        }
      }
    }
    http.end();
  }
}

