void attemptSOS() {
  lastSosAttempt = millis();
  sosAttempts++;

  // If Wi-Fi is not connected yet, actively try connecting to WIFI_SSID ("Thillai") for up to 5 seconds
  if (WiFi.status() != WL_CONNECTED && String(WIFI_SSID).length() > 0) {
    snprintf(sosStatus, sizeof(sosStatus), "SENDING SOS...");
    snprintf(sosDetail, sizeof(sosDetail), "JOINING WIFI...");
    showOledSosDispatched();
    Serial.printf("[TELEGRAM] Wi-Fi not connected. Attempting to join '%s'...\n", WIFI_SSID);
    WiFi.begin(WIFI_SSID, WIFI_PASS);
    unsigned long t0 = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - t0 < 5000UL) {
      delay(150);
      Serial.print(".");
    }
    Serial.println();
  }

  if (WiFi.status() != WL_CONNECTED) {
    snprintf(sosStatus, sizeof(sosStatus), "SOS FAILED");
    snprintf(sosDetail, sizeof(sosDetail), "WIFI THILLAI OFF");
    Serial.println("[TELEGRAM] SOS FAILED: ESP32 could not connect to Wi-Fi hotspot '" + String(WIFI_SSID) + "'.");
    if (sosAttempts >= SOS_MAX_ATTEMPTS) sosPending = false;
  } else {
    snprintf(sosStatus, sizeof(sosStatus), "SENDING SOS...");
    snprintf(sosDetail, sizeof(sosDetail), "WIFI OK->TELEGRAM");
    showOledSosDispatched();

    if (!hasGPSFix) {
      if (!hasPhoneFix && !hasNetLocation) fetchNetworkCurrentLocation();
      if (!hasPhoneFix) fetchTelegramLocationPin();
    }
    bool sent = sendTelegramSOS(buildSosText());
    if (sent) {
      sosPending = false;
      snprintf(sosStatus, sizeof(sosStatus), "SOS SENT");
      Serial.println("[TELEGRAM] SOS SENT: Confirmed by Telegram API. Sending interactive Map Pin...");
      sendTelegramLocationPin(getEffectiveLat(), getEffectiveLng());
      broadcastJSON("{\"type\":\"sos_status\",\"sent\":1,\"attempt\":" + String(sosAttempts) + "}");
    } else {
      snprintf(sosStatus, sizeof(sosStatus), "SOS FAILED");
      if (sosAttempts >= SOS_MAX_ATTEMPTS) {
        sosPending = false;
        broadcastJSON("{\"type\":\"sos_status\",\"sent\":0,\"attempt\":" + String(sosAttempts) + "}");
      } else {
        Serial.println("[TELEGRAM] SOS FAILED on this attempt; will retry in background.");
      }
    }
  }
  sosStatusShownUntilMs = millis() + SOS_TEMP_BANNER_MS;
  if (currentState == STATE_SOS_DISPATCHED) showOledSosDispatched();
}

void serviceSosRetry() {
  // Retries continue even if the SOS display has been dismissed/re-armed.
  if (!sosPending) return;
  if (millis() - lastSosAttempt >= SOS_RETRY_MS) attemptSOS();
}

// ============================================================================
// BUZZER / BROADCAST
// ============================================================================
void setBuzzerTone(int freqHz) {
  if (freqHz <= 0 || !buzzerAudioEnabled) {
    digitalWrite(PIN_BUZZER, LOW);
    return;
  }
  digitalWrite(PIN_BUZZER, HIGH);
}

void playBuzzerPattern(int pulses, int onMs, int gapMs, int freqHz) {
  if (!buzzerAudioEnabled || pulses <= 0) return;
  buzzerPulsesLeft  = pulses;
  buzzerPulseOnMs   = onMs;
  buzzerPulseGapMs  = gapMs;
  buzzerPulseFreqHz = (freqHz > 0) ? freqHz : 2000;
  buzzerPulseHigh   = true;
  setBuzzerTone(buzzerPulseFreqHz);
  buzzerNextEdgeMs  = millis() + (unsigned long)onMs;
  buzzerOffAt       = 0;
}

void triggerBuzzer(int freqHz, int durationMs) {
  playBuzzerPattern(1, durationMs, 40, freqHz);
}

void updateBuzzer() {
  unsigned long now = millis();

  if (alarmActive && buzzerAudioEnabled) {
    unsigned long phase = now % 1000UL;
    bool chirpOn = (phase < 90UL) || (phase >= 160UL && phase < 250UL);
    setBuzzerTone(chirpOn ? 2400 : 0);
    return;
  }

  if (buzzerPulsesLeft > 0) {
    if ((long)(now - buzzerNextEdgeMs) >= 0) {
      if (buzzerPulseHigh) {
        buzzerPulseHigh = false;
        setBuzzerTone(0);
        buzzerPulsesLeft--;
        if (buzzerPulsesLeft > 0) {
          buzzerNextEdgeMs = now + (unsigned long)buzzerPulseGapMs;
        }
      } else {
        buzzerPulseHigh = true;
        setBuzzerTone(buzzerPulseFreqHz);
        buzzerNextEdgeMs = now + (unsigned long)buzzerPulseOnMs;
      }
    }
    return;
  }

  if (buzzerOffAt != 0 && (long)(now - buzzerOffAt) >= 0) {
    setBuzzerTone(0);
    buzzerOffAt = 0;
  }
}

void broadcastJSON(const String& json) {
  const char* c = json.c_str();
  size_t len = json.length(), i = 0;
  while (i < len) {
    size_t n = (len - i > 16) ? 16 : (len - i);
    Serial.write((const uint8_t*)(c + i), n);
    i += n;
    readMPU6050();                      // sample between small Serial chunks
  }
  Serial.write('\n');
  if (WiFi.status() == WL_CONNECTED) {
    udp.beginPacket("255.255.255.255", 8888);
    udp.print(json);
    udp.endPacket();
  }
#if ENABLE_BLUETOOTH
  if (SerialBT.hasClient()) {
    SerialBT.println(json);
  }
#endif
}

// ============================================================================
// GPS (NMEA with checksum + safe field parsing)
// ============================================================================
static bool nmeaChecksumOk(const String& s) {
  int star = s.indexOf('*');
  if (star < 1 || (int)s.length() < star + 3) return false;
  uint8_t cs = 0;
  for (int i = 1; i < star; i++) cs ^= (uint8_t)s.charAt(i);
  uint8_t given = (uint8_t)strtol(s.substring(star + 1, star + 3).c_str(), NULL, 16);
  return cs == given;
}

static String getField(const String& s, int n) {       // n=0 is the sentence id ("$GPRMC")
  int start = 0;
  for (int i = 0; i < n; i++) {
    start = s.indexOf(',', start);
    if (start < 0) return "";
    start++;
  }
  int end = s.indexOf(',', start);
  int star = s.indexOf('*', start);
  if (end < 0 || (star >= 0 && star < end)) end = (star >= 0) ? star : s.length();
  return s.substring(start, end);
}

static bool parseNmeaCoord(const String& v, const String& hem, int degDigits, double& out) {
  if ((int)v.length() < degDigits + 2) return false;
  double deg = v.substring(0, degDigits).toDouble();
  double minutes = v.substring(degDigits).toDouble();
  double val = deg + minutes / 60.0;
  if (hem == "S" || hem == "W") val = -val;
  out = val;
  return true;
}

static void markFix() {
  hasGPSFix = true;
  hasEverHadFix = true;
  lastValidGPSTime = millis();
}

void parseNMEASentence(const String& s) {
  if (s.length() < 10) return;
  if (!nmeaChecksumOk(s)) { gpsBadSentences++; return; }
  gpsGoodSentences++;
  String type = getField(s, 0).substring(3);   // "RMC", "GGA", "GSV"...
  double v;

  if (type == "RMC") {
    if (getField(s, 2) == "A") {
      double lat = 0.0, lng = 0.0;
      bool latOK = parseNmeaCoord(getField(s, 3), getField(s, 4), 2, lat);
      bool lngOK = parseNmeaCoord(getField(s, 5), getField(s, 6), 3, lng);
      if (latOK && lngOK && fabs(lat) <= 90.0 && fabs(lng) <= 180.0 && (lat != 0.0 || lng != 0.0)) {
        realLat = lat; realLng = lng; markFix();
      }
      String spd = getField(s, 7);
      if (spd.length() > 0) realSpeedKmh = spd.toFloat() * 1.852f;
    } else {
      hasGPSFix = false;
      realSpeedKmh = 0;
    }
  } else if (type == "GGA") {
    satsUsed = getField(s, 7).toInt();
    String q = getField(s, 6);
    if (q.length() > 0 && q != "0") {
      double lat = 0.0, lng = 0.0;
      bool latOK = parseNmeaCoord(getField(s, 2), getField(s, 3), 2, lat);
      bool lngOK = parseNmeaCoord(getField(s, 4), getField(s, 5), 3, lng);
      if (latOK && lngOK && fabs(lat) <= 90.0 && fabs(lng) <= 180.0 && (lat != 0.0 || lng != 0.0)) {
        realLat = lat; realLng = lng; markFix();
      }
    } else {
      hasGPSFix = false;
    }
  } else if (type == "GSV") {
    String inView = getField(s, 3);
    if (inView.length() > 0) satsInView = inView.toInt();
  }
  realSatellites = hasGPSFix ? satsUsed : satsInView;
}

void readGPSModule() {
  static String nmea = "";
  static bool firstByteLogged = false;
  static unsigned long lastDiag = 0, lastBaudSwitch = 0, lastGpsRestart = 0;

  while (gpsSerial.available() > 0) {
    char c = gpsSerial.read();
    totalGpsBytes++;
    lastGpsByteTime = millis();
    if (!firstByteLogged) { firstByteLogged = true; Serial.println("[GPS] Receiving data from module."); }

    if (c == '\n') {
      nmea.trim();
      if (gpsRaw && nmea.length() > 0) Serial.println("[NMEA] " + nmea);
      if (nmea.length() > 0 && nmea.charAt(0) == '$') parseNMEASentence(nmea);
      nmea = "";
    } else if (c != '\r') {
      if (nmea.length() < 120) nmea += c; else nmea = "";
    }
  }

  // bytes arrive but nothing is valid NMEA -> wrong baud rate (some modules use 38400 / 115200)
  if (totalGpsBytes > 200 && gpsGoodSentences == 0 && millis() - lastGpsByteTime < 2000 && millis() - lastBaudSwitch > 6000) {
    lastBaudSwitch = millis();
    gpsBaudIdx = (gpsBaudIdx + 1) % 4;
    gpsSerial.updateBaudRate(GPS_BAUDS[gpsBaudIdx]);
    Serial.printf("[GPS] Data but no valid NMEA -> trying %lu baud\n", GPS_BAUDS[gpsBaudIdx]);
  }

  if (millis() - lastGpsByteTime > 10000 && millis() - lastGpsRestart > 10000) {
    lastGpsRestart = millis();
    Serial.println("[GPS] Silent for 10 s -> restarting UART2 (check wires if this repeats)");
    gpsSerial.end();
    gpsSerial.setRxBufferSize(1024);
    gpsSerial.begin(GPS_BAUDS[gpsBaudIdx], SERIAL_8N1, PIN_GPS_RX, PIN_GPS_TX);
  }

  if (hasGPSFix && millis() - lastValidGPSTime > 5000) {
    hasGPSFix = false;
    realSpeedKmh = 0;
    realSatellites = satsInView;
  }

  if (millis() - lastDiag > 5000) {              // plain-English GPS status every 5 s
    lastDiag = millis();
    const char* st;
    if (totalGpsBytes == 0 || millis() - lastGpsByteTime > 3000) st = "NO DATA from module -> check wiring (GPS TX->GPIO16), GND, 5V";
    else if (gpsGoodSentences == 0)                              st = "DATA but invalid -> baud/wiring noise";
    else if (!hasGPSFix)                                         st = "Module OK, SEARCHING for satellites (needs open sky - will not lock indoors)";
    else                                                         st = "FIX OK";
    Serial.printf("[GPS] %s | bytes=%lu good=%lu bad=%lu used=%d inview=%d\n",
                  st, totalGpsBytes, gpsGoodSentences, gpsBadSentences, satsUsed, satsInView);
  }
}

