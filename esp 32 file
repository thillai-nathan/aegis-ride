void setupWebServer() {
  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html", INDEX_HTML);
  });
  server.on("/sos", HTTP_GET, []() {
    sosCustomAlertLine[0] = 0;
    dispatchSOS("WEB_DASHBOARD_SOS", fmaxf(shockShown, currentG), false);
    server.send(200, "text/plain", "🚨 Emergency SOS Triggered! Sending Telegram alert...");
  });
  server.on("/cancel", HTTP_GET, []() {
    if (currentState == STATE_CRASH_COUNTDOWN) {
      cancelAlarm("web_dashboard_before_dispatch");
      server.send(200, "text/plain", "Countdown cancelled. No SOS was sent.");
    } else if (currentState == STATE_SOS_DISPATCHED) {
      // Clear the OLED SOS screen and re-arm from the dashboard if the physical button is unavailable.
      // Any pending Telegram retry is allowed to continue in the background.
      dismissSOS();
      server.send(200, "text/plain", "SOS screen dismissed and system re-armed. Any pending Telegram retry continues; delivered messages cannot be recalled.");
    } else { server.send(200, "text/plain", "No active countdown."); }
  });
  // Web dashboard can post browser GPS coordinates here after the user taps Enable Phone Location.
  // Browser geolocation on plain HTTP may be blocked by Android Chrome; see README.
  server.on("/api/phone-location", HTTP_GET, []() {
    if (!server.hasArg("lat") || !server.hasArg("lng")) {
      server.send(400, "text/plain", "Missing lat/lng"); return;
    }
    double lat = server.arg("lat").toDouble();
    double lng = server.arg("lng").toDouble();
    float acc = server.hasArg("accuracy") ? server.arg("accuracy").toFloat() : 9999.0f;
    if (lat < -90 || lat > 90 || lng < -180 || lng > 180 || (lat == 0 && lng == 0)) {
      server.send(400, "text/plain", "Invalid coordinates"); return;
    }
    phoneLat = lat; phoneLng = lng; phoneAccuracyM = acc;
    phoneLocationAt = millis(); hasPhoneFix = true;
    if (server.hasArg("area") && server.arg("area").length() > 0) {
      String a = server.arg("area"); a.trim();
      strncpy(riderAreaName, a.c_str(), sizeof(riderAreaName) - 1);
      riderAreaName[sizeof(riderAreaName) - 1] = 0;
    }
    Serial.printf("[WEB GPS] Locked Rider Current Location: %s (%.6f, %.6f)\n", riderAreaName, phoneLat, phoneLng);
    server.send(200, "text/plain", "Phone location received");
  });
  server.on("/api/telemetry", HTTP_GET, []() {
    String json = "{";
    json += "\"speed\":" + String(curSpeedKmh(), 1) + ",";
    json += "\"g_force\":" + String(currentG, 2) + ",";
    json += "\"pitch\":" + String(pitchDeg, 1) + ",";
    json += "\"roll\":" + String(rollDeg, 1) + ",";
    json += "\"tilt\":" + String(tiltDev, 1) + ",";
    json += "\"battery\":" + String(batteryPercentage) + ",";
    json += "\"battery_v\":" + String(batteryVoltage, 2) + ",";
    json += "\"lat\":" + String(getEffectiveLat(), 6) + ",";
    json += "\"lng\":" + String(getEffectiveLng(), 6) + ",";
    json += "\"satellites\":" + String(realSatellites) + ",";
    json += "\"gps_fix\":" + String(hasGPSFix ? "true" : "false") + ",";
    json += "\"phone_fix\":" + String(hasPhoneFix ? "true" : "false") + ",";
    json += "\"loc_source\":\"" + String(getLocationSourceTag()) + "\",";
    json += "\"state\":" + String((int)currentState);
    json += "}";
    server.send(200, "application/json", json);
  });
  server.on("/api/events", HTTP_GET, []() {
    String json = "{\"events\":[";
    unsigned int n = evtCount < EVT_LOG_SIZE ? evtCount : EVT_LOG_SIZE;
    for (unsigned int i=0; i<n; i++) {
      const EvtRec* e = newestEvt(i); if (!e) continue;
      if (i) json += ",";
      json += "{\"tag\":\"" + String(e->tag) + "\",\"sub\":\"" + String(e->sub) + "\",\"g\":" + String(e->g,2) + ",\"tilt\":" + String(e->tilt,1) + ",\"ago_s\":" + String((millis()-e->t)/1000) + "}";
    }
    json += "]}"; server.send(200, "application/json", json);
  });
  // Single tactile-button click requests that the dashboard reveal the newest event.
  server.on("/api/button-last-event", HTTP_GET, []() {
    unsigned long requestId = buttonLastEventRequestId;
    String json = "{\"request_id\":" + String(requestId);
    const EvtRec* e = newestEvt(0);
    if (e) {
      json += ",\"has_event\":true,\"tag\":\"" + String(e->tag) + "\",\"sub\":\"" + String(e->sub) +
              "\",\"g_force\":" + String(e->g, 2) + ",\"tilt\":" + String(e->tilt, 1) +
              ",\"ago_s\":" + String((millis() - e->t) / 1000);
    } else {
      json += ",\"has_event\":false,\"tag\":\"NONE\",\"sub\":\"\",\"g_force\":0,\"tilt\":0,\"ago_s\":0";
    }
    json += "}";
    server.send(200, "application/json", json);
  });
  server.begin();
  Serial.println("[WEB] Emergency Web Server started on port 80.");
}

