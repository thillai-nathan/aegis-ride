// Hardware Interrupt Service Routine: catches every button press instantly even during I2C/OLED/WiFi work
void IRAM_ATTR onSosButtonISR() {
  unsigned long nowUs = micros();
  if (nowUs - lastIsrFallUs >= 55000UL) {
    if (digitalRead(PIN_BUTTON) == LOW) {
      lastIsrFallUs = nowUs;
      if (isrButtonPressQueue < 10) {
        isrButtonPressQueue++;
      }
    }
  }
}

