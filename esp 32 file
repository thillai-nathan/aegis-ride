// ============================================================================
// BATTERY
// ============================================================================
void readBattery() {
  long sum = 0;
  for (int i = 0; i < 8; i++) sum += analogRead(PIN_BATTERY_ADC);
  float raw = sum / 8.0f;
  float v = (raw / 4095.0f) * 3.3f * 2.0f * 1.05f;
  if (v >= 2.80f && v <= 4.35f) {
    isBatteryConnected = true;
    batteryVoltage = v;
    float pct = (v - 3.30f) / (4.20f - 3.30f) * 100.0f;
    if (pct > 100) pct = 100;
    if (pct < 0) pct = 0;
    batteryPercentage = (int)pct;
  } else {
    isBatteryConnected = false;
    batteryVoltage = 4.15f;
    batteryPercentage = 100;
  }
}

